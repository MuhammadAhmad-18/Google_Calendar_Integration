# Official ChatBeds Partner v1 address (no runtime fallback)
APP_ACCESS_MODE=private
APP_NAME="Chatbeds x Google Calendar"
# Public mode requires CHATBEDS_AUTH_MODE=oauth, migrations 003+004, and Supabase Google Auth.
# Enable Google's provider with the SAME GOOGLE_CLIENT_ID below; no email OTP/SMTP needed.
SUPABASE_PUBLISHABLE_KEY=REPLACE_ME
PUBLIC_SUPPORT_EMAIL=mrmado835@gmail.com
PUBLIC_OPERATOR_NAME=REPLACE_ME
DATA_RETENTION_DAYS=90
CHATBEDS_AUTH_MODE=api_key
CHATBEDS_API_BASE_URL=https://app.chatbeds.app/partner/v1
# Required only for api_key mode. OAuth mode never falls back to this key.
CHATBEDS_API_KEY=cbk_REPLACE_ME
# In oauth mode use the APP webhook secret from Developers, not the private key.
CHATBEDS_WEBHOOK_SECRET=whsec_REPLACE_ME
CHATBEDS_WEBHOOK_URL=http://localhost:3000/api/webhooks/chatbeds

# Phase 2: set CHATBEDS_AUTH_MODE=oauth and configure all six values below.
CHATBEDS_CLIENT_ID=cba_REPLACE_ME
CHATBEDS_CLIENT_SECRET=cbs_REPLACE_ME
CHATBEDS_REDIRECT_URI=http://localhost:3000/api/chatbeds/callback
CHATBEDS_OAUTH_AUTHORIZE_URL=https://app.chatbeds.app/oauth/authorize
CHATBEDS_OAUTH_TOKEN_URL=https://app.chatbeds.app/oauth/token
CHATBEDS_OAUTH_REVOKE_URL=https://app.chatbeds.app/oauth/revoke

GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_CALENDAR_ID=primary

NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_URL=https://REPLACE_ME.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=REPLACE_ME
# Generate independently with the same command. Used to sign secure sessions.
SESSION_SECRET=REPLACE_ME
# Generate independently; your single-admin dashboard password.
ADMIN_PASSWORD=REPLACE_ME
# Generate independently; Vercel sends this as Bearer authorization to cron.
CRON_SECRET=REPLACE_ME
